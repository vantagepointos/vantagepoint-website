# Optional. Leave blank and the matching tag is omitted.
# Read at build time. Nothing here loads during `next dev` unless you set an ID.

# GA4 measurement ID, for example G-XXXXXXXX
NEXT_PUBLIC_GA_ID=

# Older name for the same GA4 ID. Used only when NEXT_PUBLIC_GA_ID is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID. Loads only after the visitor accepts cookies.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Search Console verification token (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Older name for the same Search Console token. Used only when the variable above is empty.
NEXT_PUBLIC_GSC_VERIFICATION=
